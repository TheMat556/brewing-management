# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
#
# Local development: copy these values from `bunx supabase status`.
# Use the publishable key (or legacy anon key). Never use the secret/service-role key
# or a database password in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional server-side URL. Use this when NEXT_PUBLIC_SUPABASE_URL is a public
# code-server proxy such as https://<host>/proxy/54321 but Node-side auth calls
# should reach the local Supabase API directly.
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321

# Optional, development-only. Use /absproxy/3000 when opening the app through
# code-server's /absproxy route. Leave blank for normal localhost development.
NEXT_PUBLIC_BASE_PATH=
