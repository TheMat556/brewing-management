# Copy this file to .env.test.local (ignored by Git) and fill in local values from:
#   bunx supabase status -o env
#
# Integration tests refuse to run unless the API and database hosts are local and the
# database port is 54322. Never point these at a hosted production project.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
